# Copy to backend/.env; paths default to this repository, independent of cwd.
DEVCLUB_PUBLIC_API_BASE=/api/backend
DEVCLUB_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Enable when deployed behind HTTPS; keep false for local HTTP.
DEVCLUB_COOKIE_SECURE=false
# Local SMTP capture: run Mailpit or another SMTP server on port 1025.
# Set a real sender/domain and enable TLS/auth for production SMTP.
# DEVCLUB_SMTP_HOST=127.0.0.1
DEVCLUB_SMTP_PORT=1025
DEVCLUB_SMTP_STARTTLS=false
DEVCLUB_SMTP_SSL=false
DEVCLUB_MAIL_FROM=devclub@example.com
# DEVCLUB_SMTP_USERNAME=
# DEVCLUB_SMTP_PASSWORD=
